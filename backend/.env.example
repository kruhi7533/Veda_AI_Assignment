# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# MongoDB - get free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb://localhost:27017/vedaai

# Redis - get free instance at https://upstash.com or run locally
REDIS_URL=redis://localhost:6379

# Google Gemini API Key - get free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: mock LLM during development (no API key required)
USE_MOCK_LLM=false

# PDF generator
PDF_TMP_DIR=./tmp
